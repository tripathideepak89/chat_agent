{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PrimaryTopic": "chat.sessions.primary",
    "OverflowTopic": "chat.sessions.overflow",
    "ConsumerGroup": "chat-router"
  },
  "Couchbase": {
    "ConnectionString": "couchbase://localhost",
    "Username": "Administrator",
    "Password": "password",
    "Bucket": "support",
    "Scope": "_default",
    "Collection": "_default"
  },
  "ChatRouting": {
    "TimeZoneId": "UTC",
    "OfficeHoursStart": "09:00:00",
    "OfficeHoursEnd": "17:00:00",
    "MaxMissedPolls": 3,
    "ExpectedPollIntervalSeconds": 1,
    "LockTtlSeconds": 10,
    "AssignmentTickMs": 150,
    "InactivityScanMs": 800
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
